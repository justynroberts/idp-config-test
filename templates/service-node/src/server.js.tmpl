import { createServer } from 'node:http';

const port = Number(process.env.PORT ?? 8080);

createServer((req, res) => {
  if (req.url === '/health') return res.writeHead(200, { 'content-type': 'application/json' }).end('{"ok":true}');
  res.writeHead(200, { 'content-type': 'application/json' }).end(JSON.stringify({ service: '{{ values.name }}' }));
}).listen(port, () => console.log(`{{ values.name }} listening on ${port}`));
